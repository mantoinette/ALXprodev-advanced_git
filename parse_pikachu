#!/bin/bash

# Extract values directly with jq
name=$(jq -r '.name' pikachu.json)
type=$(jq -r '.types[0].type.name' pikachu.json)
weight=$(jq -r '.weight' pikachu.json)
height=$(jq -r '.height' pikachu.json)

# Capitalize first letter with sed
name=$(echo "$name" | sed 's/^\(.\)/\U\1/')
type=$(echo "$type" | sed 's/^\(.\)/\U\1/')

# Convert weight (hectograms to kg) and height (decimeters to meters)
weight_kg=$(awk "BEGIN {printf \"%.0f\", $weight / 10}")
height_m=$(awk "BEGIN {printf \"%.1f\", $height / 10}")

# Print formatted output
echo "$name is of type $type, weighs ${weight_kg}kg, and is ${height_m}m tall."

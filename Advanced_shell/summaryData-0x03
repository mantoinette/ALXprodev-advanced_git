#!/bin/bash

# Output file
report="pokemon_report.csv"

# Write CSV header
echo "Name,Height (m),Weight (kg)" > "$report"

# Variables for calculating averages
total_height=0
total_weight=0
count=0

# Loop over all .json files in current folder
for file in *.json; do
  # Extract values with jq
  name=$(jq -r '.name' "$file")
  height_dm=$(jq -r '.height' "$file")   # decimeters
  weight_hg=$(jq -r '.weight' "$file")   # hectograms

  # Convert to meters and kg using awk
  height_m=$(awk "BEGIN {printf \"%.1f\", $height_dm / 10}")
  weight_kg=$(awk "BEGIN {printf \"%.1f\", $weight_hg / 10}")

  # Append to CSV
  echo "$(echo "$name" | sed 's/^\(.\)/\U\1/'),$height_m,$weight_kg" >> "$report"

  # Add to totals for averages
  total_height=$(awk "BEGIN {print $total_height + $height_m}")
  total_weight=$(awk "BEGIN {print $total_weight + $weight_kg}")
  count=$((count + 1))
done

echo ""
echo "CSV Report generated at: $report"
echo ""

# Calculate and print averages
if [ "$count" -gt 0 ]; then
  avg_height=$(awk "BEGIN {printf \"%.2f\", $total_height / $count}")
  avg_weight=$(awk "BEGIN {printf \"%.2f\", $total_weight / $count}")

  echo "Average Height: $avg_height m"
  echo "Average Weight: $avg_weight kg"
else
  echo "No Pokémon data found."
fi
